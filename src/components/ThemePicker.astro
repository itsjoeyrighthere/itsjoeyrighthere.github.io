---
import { themes } from '../config/themes';
---
<div class="appearance-control" data-theme-picker>
  <button class="theme-trigger" type="button" data-theme-open aria-expanded="false" aria-controls="theme-panel"><span class="theme-trigger-swatch" aria-hidden="true"></span><span>配色</span></button>
  <section class="theme-panel" id="theme-panel" aria-labelledby="appearance-title" hidden>
    <div class="theme-panel-heading"><div><h2 id="appearance-title">网站配色</h2><p>当前：<span data-theme-current>纸白钴蓝</span></p></div><button class="theme-panel-close" type="button" data-theme-close aria-label="关闭配色选择">×</button></div>
    <div class="theme-options" role="group" aria-label="网站配色方案">
      {themes.map(theme => <button type="button" data-theme-option={theme.id} aria-pressed={theme.id === 'paper'} aria-label={`${theme.name}：${theme.description}`}>
        <span class="theme-palette" style={`--swatch-bg:${theme.background};--swatch-ink:${theme.ink};--swatch-brand:${theme.brand}`} aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="theme-option-name">{theme.name}</span><span class="theme-selected" aria-hidden="true">✓</span>
      </button>)}
    </div>
    <p class="theme-panel-hint" role="status">选择仅保存在此浏览器</p>
  </section>
</div>
